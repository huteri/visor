            android:action="android.intent.action.VIEW"
            android:targetClass="com.macedonga.visor.MainActivity"
            android:targetPackage="com.macedonga.visor.debug">
            <extra
                android:name="open"
                android:value="live" />
        </intent>
    </shortcut>
    <shortcut
